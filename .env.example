# Optional. Defaults to ./.local-data
SYNTH_DATA_DIR=

# Required for on-demand Sinhala data generation.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash. You may also use short names like 2.5-flash.
GEMINI_MODEL=

# Required to store generated form details in Firestore.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
